# Django
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Frontend dev server (Vite default)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# OpenRouteService — https://openrouteservice.org/dev/#/signup
# Required for geocoding and HGV routing (server-side only).
ORS_API_KEY=

# Optional: comma-separated extra CORS origins for deployed frontend
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://your-app.vercel.app
